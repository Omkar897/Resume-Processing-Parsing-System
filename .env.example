# Required service credentials (add these in Vercel Project Settings -> Environment Variables)
FIREWORKS_API_KEY=
SERPAPI_KEY=

# Optional email configuration. Email is disabled by default on Vercel.
# Set EMAIL_ENABLED=1 only when using a provider supported by your deployment.
EMAIL_ENABLED=0
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional Fireworks model settings
FIREWORKS_PRIMARY_CHAT_MODEL=fireworks/minimax-m2p7
FIREWORKS_FALLBACK_CHAT_MODEL=fireworks/deepseek-v3p2
FIREWORKS_EMBED_MODEL=fireworks/qwen3-embedding-8b
FIREWORKS_RERANK_MODEL=fireworks/qwen3-reranker-8b
USE_FIREWORKS_LLM=1
USE_LLM_QUERY_EXPANSION=1
USE_LLM_RERANK=1
LLM_QUERY_EXPANSIONS=2
LLM_RERANK_TOP_K=8
