# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Fireworks LLM Configuration
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_PRIMARY_CHAT_MODEL=fireworks/minimax-m2p7
FIREWORKS_FALLBACK_CHAT_MODEL=fireworks/deepseek-v3p2
FIREWORKS_EMBED_MODEL=fireworks/qwen3-embedding-8b
FIREWORKS_RERANK_MODEL=fireworks/qwen3-reranker-8b
USE_FIREWORKS_LLM=1

# SerpAPI Configuration (Job Search)
SERPAPI_KEY=your_serpapi_key_here

# APILayer Configuration (Resume Extraction)
APILAYER_KEY=your_apilayer_api_key_here

# Email Configuration (Optional)
MAIL_USERNAME=your_email_username
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=your_email@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1

# Railway Configuration
RENDER=0
RENDER_EMAIL_DISABLED=0

# Performance Configuration
SCRAPER_TIMEOUT_SECONDS=180
USE_LLM_QUERY_EXPANSION=1
USE_LLM_RERANK=1

# Database Configuration (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
