# Strict allowlist: ignore everything first
*

# Root files required for app/deploy/docs
!.gitignore
!README.md
!LICENSE
!requirements.txt
!render.yaml
!railway.toml
!Procfile
!Dockerfile
!docker-compose.yml
!.dockerignore
!.env.example

# Required source trees
!web/
!web/**
!src/
!src/**
!LLM/
!LLM/**
!models/
!models/**
!tests/
!tests/**

# Optional legacy entrypoint kept for compatibility
!main.py

# Ignore local/runtime artifacts even inside allowed folders
.env
venv/
env/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.sqlite3
*.log
*.tmp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime/generated data and uploads
data/
web/static/uploads/*
!web/static/uploads/.gitkeep

# Generated results
src/jobs/*.json
!src/jobs/.gitkeep
*_20??-??-??.json
test_output.txt


